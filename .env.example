# Local development: FastAPI running directly on the host
DATABASE_URL=postgresql+psycopg://incidentcopilot:change-me-local-only@localhost:5432/incidentcopilot

# PostgreSQL development configuration
POSTGRES_DB=incidentcopilot
POSTGRES_USER=incidentcopilot
POSTGRES_PASSWORD=change-me-local-only

# Optional services
QDRANT_URL=http://localhost:6333
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# Application settings
LOG_CORRELATION_WINDOW_SECONDS=300
RAG_TOP_K=5